# Copy to .env and fill in values (non-secret / service config).
# Sensitive values for Docker also go to ./secrets/ — run: ./scripts/prepare-docker-secrets.sh

# --- Application ---
HOST=0.0.0.0
PORT=1414
# true: load default municipal data on startup; false: wait for API uploads
INIT_EMBEDDINGS=true
# Path to 7z (Docker sets /usr/bin/7z automatically)
SEVEN_ZIP_BIN=

# --- PostgreSQL (app) ---
DB_HOST=127.0.0.1
DB_PORT=1212
DB_NAME=geo_embeddings
DB_USER=georgiykiselev
DB_PWD=change_me

# --- Qdrant ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=municipality_embeddings
QDRANT_HTTPS=false
QDRANT_API_KEY=

# --- Hugging Face (optional) ---
HF_TOKEN=
HF_BEST_REPO_ID=
HF_BEST_REPO_TYPE=model
HF_BEST_REPO_PRIVATE=false
HF_BEST_REPO_REVISION=
HF_BEST_PATH_IN_REPO=main

# --- Data sources (INIT_EMBEDDINGS=true) ---
TOCHNO_ST_BASE_LINK=https://storage.yandexcloud.net/tochno-st-catalog/Rosstat/data_bdmo_118_v20250918/indicators/section<section_id>/data_Y4<dataset_code>_112_v20250918.zip
MUN_GEOMS_LINK=https://s.sber.ru/GthXk7
OVERPASS_API_LINK=https://overpass.openstreetmap.fr/api/
FLATS_TASK_LINK=https://raw.githubusercontent.com/mishannn/cianparser/main/offers.json

CHECK_PEOPLE_WORKPLACES_TASKS=false
PEOPLE_FEATURES=[]
PEOPLE_CAT_FEATURES=[]
WORKPLACES_FEATURES=[]
WORKPLACES_CAT_FEATURES=[]
